# ===========================================
# Suất Ăn Công Nghiệp - Environment Variables
# ===========================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URI=postgresql://user:password@localhost:5432/suat_an_cong_nghiep

# --- Payload CMS ---
# Secret key for Payload authentication (generate a random string)
PAYLOAD_SECRET=your-payload-secret-key-change-this

# --- Site URL ---
# Public-facing URL of the website
NEXT_PUBLIC_SITE_URL=https://suatancn.com

# Server URL for Payload CMS API
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# CSRF allowed origins (comma-separated)
CSRF_URLS=https://suatancn.com,https://www.suatancn.com

# --- Email (Resend) ---
# API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# From email address (must be verified in Resend)
FROM_EMAIL=noreply@suatancn.com

# Email to receive form notifications (sales team)
NOTIFICATION_EMAIL=sales@suatancn.com

# --- SEO / Analytics ---
# Google Search Console verification code
GOOGLE_SITE_VERIFICATION=your-google-verification-code

# --- Storage ---
# Local media upload directory (relative to project root)
MEDIA_DIR=media
